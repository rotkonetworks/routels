{
  "name": "routels",
  "displayName": "routels: network config linter and LSP",
  "description": "Offline linter and language server for 10 network config formats: Arista EOS, FRR (vtysh), VyOS, MikroTik RouterOS, BIRD, nftables, HAproxy, WireGuard, sysctl, Debian /etc/network/interfaces.",
  "version": "0.1.0",
  "publisher": "rotko",
  "preview": true,
  "license": "MIT OR Apache-2.0",
  "author": { "name": "Rotko Networks", "email": "hq@rotko.net" },
  "homepage": "https://github.com/rotkonetworks/routels#readme",
  "repository": { "type": "git", "url": "https://github.com/rotkonetworks/routels.git" },
  "bugs": { "url": "https://github.com/rotkonetworks/routels/issues" },
  "qna": "marketplace",
  "galleryBanner": { "color": "#0b1220", "theme": "dark" },
  "keywords": [
    "bgp",
    "ospf",
    "arista",
    "eos",
    "frr",
    "vyos",
    "mikrotik",
    "routeros",
    "bird",
    "nftables",
    "iptables",
    "haproxy",
    "wireguard",
    "sysctl",
    "network",
    "network configuration",
    "network linter",
    "language server",
    "lsp",
    "netops",
    "network automation",
    "router",
    "firewall",
    "sarif"
  ],
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Linters", "Other"],
  "activationEvents": [
    "onLanguage:frr",
    "onLanguage:eos",
    "onLanguage:vyos",
    "onLanguage:routeros",
    "onLanguage:bird",
    "onLanguage:nftables",
    "onLanguage:debinterfaces",
    "onLanguage:wireguard",
    "onLanguage:haproxy",
    "onLanguage:sysctl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "frr",
        "aliases": ["FRR", "vtysh"],
        "filenamePatterns": ["**/vtysh.conf", "**/frr.conf", "**/upstream/*.conf", "**/vyos/vyos*.conf"],
        "configuration": "./language-config-bang.json"
      },
      {
        "id": "eos",
        "aliases": ["Arista EOS"],
        "filenamePatterns": ["**/ceos/*.cfg", "**/arista/*.cfg", "**/eos/*.cfg"],
        "configuration": "./language-config-bang.json"
      },
      {
        "id": "vyos",
        "aliases": ["VyOS"],
        "filenamePatterns": ["**/config.boot", "**/*.boot"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "routeros",
        "aliases": ["MikroTik RouterOS"],
        "extensions": [".rsc"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "bird",
        "aliases": ["BIRD"],
        "filenames": ["bird.conf", "bird2.conf"],
        "filenamePatterns": ["**/bird/*.conf", "**/*-bird.conf"],
        "configuration": "./language-config-c.json"
      },
      {
        "id": "nftables",
        "aliases": ["nftables"],
        "extensions": [".nft"],
        "filenamePatterns": ["**/nftables*.conf", "**/nftables.d/*.nft"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "debinterfaces",
        "aliases": ["Debian interfaces"],
        "filenames": ["interfaces"],
        "filenamePatterns": ["**/interfaces.d/*", "**/interfaces/*.conf", "**/*-interfaces.conf"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "wireguard",
        "aliases": ["WireGuard"],
        "filenamePatterns": ["**/wireguard/*.conf", "**/wg*.conf"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "haproxy",
        "aliases": ["HAproxy"],
        "filenamePatterns": ["**/haproxy.cfg", "**/*-haproxy.cfg", "**/haproxy/*.cfg"],
        "configuration": "./language-config-hash.json"
      },
      {
        "id": "sysctl",
        "aliases": ["sysctl"],
        "filenamePatterns": ["**/sysctl.conf", "**/sysctl.d/*.conf"],
        "configuration": "./language-config-hash.json"
      }
    ],
    "configuration": {
      "title": "routels",
      "properties": {
        "routels.path": {
          "type": "string",
          "default": "routels",
          "description": "Path to the routels binary. Leave as 'routels' if it is on $PATH."
        },
        "routels.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace routels LSP server communication (for debugging)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
