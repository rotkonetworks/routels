{
  "name": "VyOS",
  "scopeName": "source.vyos",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string-single" },
    { "include": "#string-double" },
    { "include": "#prefix" },
    { "include": "#ip6" },
    { "include": "#ip4" },
    { "include": "#number" },
    { "include": "#key" },
    { "include": "#root" },
    { "include": "#verb" },
    { "include": "#brace" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.vyos",
      "match": "^\\s*#.*$"
    },
    "string-single": {
      "name": "string.quoted.single.vyos",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.vyos",
          "match": "\\\\."
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.vyos",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.vyos",
          "match": "\\\\."
        }
      ]
    },
    "prefix": {
      "name": "constant.numeric.ip.prefix.vyos",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip6": {
      "name": "constant.numeric.ip.v6.vyos",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "ip4": {
      "name": "constant.numeric.ip.v4.vyos",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "number": {
      "name": "constant.numeric.vyos",
      "match": "\\b\\d+\\b"
    },
    "verb": {
      "name": "keyword.control.vyos",
      "match": "\\b(set|delete|commit|save|show|comment|edit|top|up|exit|load|discard|compare|run)\\b"
    },
    "root": {
      "name": "entity.name.tag.vyos",
      "match": "\\b(interfaces|protocols|firewall|system|service|nat|nat66|vpn|policy|qos-policy|traffic-policy|high-availability|pki|container|load-balancing|vrf)\\b"
    },
    "key": {
      "name": "keyword.other.vyos",
      "match": "\\b(ethernet|bridge|vlan|loopback|dummy|wireguard|openvpn|pppoe|address|description|mtu|hw-id|ip|ipv6|route|route6|next-hop|bgp|ospf|ospfv3|rip|static|system-as|neighbor|remote-as|peer-group|source-address|ebgp-multihop|update-source|host-name|name-server|domain-name|time-zone|ntp)\\b"
    },
    "brace": {
      "name": "punctuation.section.block.vyos",
      "match": "[{}]"
    }
  }
}
