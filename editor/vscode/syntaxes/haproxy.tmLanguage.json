{
  "name": "HAproxy",
  "scopeName": "source.haproxy",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#section"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#tune-directive"
    },
    {
      "include": "#mode"
    },
    {
      "include": "#balance"
    },
    {
      "include": "#verb"
    },
    {
      "include": "#acl"
    },
    {
      "include": "#prefix"
    },
    {
      "include": "#ip6"
    },
    {
      "include": "#ip4"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.haproxy",
      "match": "^\\s*#.*$"
    },
    "string": {
      "name": "string.quoted.double.haproxy",
      "begin": "\"",
      "end": "\""
    },
    "section": {
      "name": "keyword.control.section.haproxy",
      "match": "\\b(http\\-errors|resolvers|defaults|fcgi\\-app|frontend|userlist|backend|mailers|program|global|listen|cache|peers|ring)\\b"
    },
    "directive": {
      "name": "keyword.other.haproxy",
      "match": "\\b(ssl\\-default\\-server\\-ciphers|ssl\\-default\\-server\\-options|ssl\\-default\\-bind\\-ciphers|ssl\\-default\\-bind\\-options|http\\-send\\-name\\-header|default_backend|default\\-server|http\\-response|http\\-request|monitor\\-fail|tcp\\-response|compression|description|monitor\\-net|monitor\\-uri|stick\\-table|tcp\\-request|use_backend|errorfiles|http\\-check|http\\-reuse|nameserver|rate\\-limit|errorfile|resolvers|tcp\\-check|nbthread|redirect|balance|capture|cpu\\-map|maxconn|pidfile|retries|rewrite|timeout|chroot|daemon|nbproc|option|server|group|stats|stick|bind|mode|tune|user|acl|log|no)\\b"
    },
    "tune-directive": {
      "name": "keyword.other.haproxy",
      "match": "\\btune\\.[a-z0-9._-]+\\b"
    },
    "mode": {
      "name": "storage.type.haproxy",
      "match": "\\b(health|http|tcp)\\b"
    },
    "balance": {
      "name": "support.constant.balance.haproxy",
      "match": "\\b(roundrobin|leastconn|static\\-rr|url_param|random|source|first|hdr|uri)\\b"
    },
    "verb": {
      "name": "keyword.operator.word.haproxy",
      "match": "\\b(replace\\-header|send\\-proxy\\-v2|add\\-header|del\\-header|send\\-proxy|set\\-header|set\\-query|track\\-sc0|track\\-sc1|track\\-sc2|disabled|redirect|set\\-path|ca\\-file|enabled|set\\-uri|set\\-var|backup|reject|return|tarpit|unless|verify|allow|check|inter|alpn|auth|deny|fall|rise|crt|ssl|if)\\b"
    },
    "acl": {
      "name": "support.function.haproxy",
      "match": "\\b(sc_http_req_rate|content\\-type|lf\\-string|srv_queue|path_beg|path_dir|path_end|path_reg|path_sub|srv_conn|hdr_beg|hdr_dir|hdr_dom|hdr_end|hdr_reg|hdr_sub|req\\.hdr|res\\.hdr|url_beg|url_dir|url_end|url_reg|url_sub|method|scheme|status|nbsrv|query|algo|base|code|host|path|dst|hdr|src|url|var)\\b"
    },
    "prefix": {
      "name": "constant.numeric.ip.cidr.haproxy",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip6": {
      "name": "constant.numeric.ip.haproxy",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "ip4": {
      "name": "constant.numeric.ip.haproxy",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "number": {
      "name": "constant.numeric.haproxy",
      "match": "\\b\\d+(ms|s|m|h|d)?\\b"
    }
  }
}
