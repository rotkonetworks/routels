{
  "name": "nftables",
  "scopeName": "source.nftables",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#prefix" },
    { "include": "#ip4" },
    { "include": "#mac" },
    { "include": "#ip6" },
    { "include": "#structure" },
    { "include": "#family" },
    { "include": "#hook" },
    { "include": "#verdict" },
    { "include": "#match" },
    { "include": "#operator" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.nftables",
      "begin": "#",
      "end": "$"
    },
    "string": {
      "name": "string.quoted.double.nftables",
      "begin": "\"",
      "end": "\""
    },
    "prefix": {
      "name": "constant.numeric.ip.prefix.nftables",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip4": {
      "name": "constant.numeric.ip.v4.nftables",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "mac": {
      "name": "constant.numeric.mac.nftables",
      "match": "\\b([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\\b"
    },
    "ip6": {
      "name": "constant.numeric.ip.v6.nftables",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "structure": {
      "name": "keyword.control.nftables",
      "match": "\\b(table|chain|set|map|flowtable|include|define|type|hook|priority|policy|device|flags|handle)\\b"
    },
    "family": {
      "name": "storage.type.family.nftables",
      "match": "\\b(inet|ip6|ip|arp|bridge|netdev)\\b"
    },
    "hook": {
      "name": "constant.language.hook.nftables",
      "match": "\\b(prerouting|input|forward|output|postrouting|ingress|egress)\\b"
    },
    "verdict": {
      "name": "keyword.control.flow.verdict.nftables",
      "match": "\\b(accept|drop|reject|return|queue|continue|jump|goto)\\b"
    },
    "match": {
      "name": "support.function.match.nftables",
      "match": "\\b(iifname|iiftype|iif|oifname|oiftype|oif|meta|mark|ct|state|status|saddr|daddr|sport|dport|protocol|tcp|udp|icmpv6|icmp|option|fib|counter|log|limit|numgen|update|timeout)\\b"
    },
    "operator": {
      "name": "keyword.operator.word.nftables",
      "match": "\\b(and|or|xor|not|in|vmap)\\b"
    },
    "number": {
      "name": "constant.numeric.nftables",
      "match": "\\b\\d+\\b"
    }
  }
}
