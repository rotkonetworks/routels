{
  "name": "FRR",
  "scopeName": "source.frr",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#prefix" },
    { "include": "#ip6" },
    { "include": "#ip4" },
    { "include": "#number" },
    { "include": "#bgp" },
    { "include": "#section" },
    { "include": "#directive" },
    { "include": "#protocol" },
    { "include": "#verb" },
    { "include": "#family" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.exclamation.frr",
          "match": "^\\s*!.*$"
        },
        {
          "name": "comment.line.number-sign.frr",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.frr",
      "begin": "\"",
      "end": "\""
    },
    "prefix": {
      "name": "constant.numeric.ip.cidr.frr",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip6": {
      "name": "constant.numeric.ip.v6.frr",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "ip4": {
      "name": "constant.numeric.ip.v4.frr",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "number": {
      "name": "constant.numeric.integer.frr",
      "match": "\\b\\d+\\b"
    },
    "bgp": {
      "name": "keyword.other.bgp.frr",
      "match": "(?<![\\w-])(neighbor|network|remote-as|peer-group|description|activate|next-hop-self|soft-reconfiguration|update-source|route-map|prefix-list|distribute-list|ebgp-multihop|send-community|route-reflector-client|multihop|allowas-in|maximum-prefix|advertisement-interval|timers|fall-over)(?![\\w-])"
    },
    "section": {
      "name": "keyword.control.frr",
      "match": "(?<![\\w-])(router|interface|vrf|exit-address-family|address-family|route-map|ip-prefix-list|prefix-list|as-path-access-list|extcommunity-list|large-community-list|community-list|bfd|line|vty)(?![\\w-])"
    },
    "directive": {
      "name": "keyword.other.directive.frr",
      "match": "(?<![\\w-])(frr|hostname|log|service|password|enable|version|defaults|integrated-vtysh-config)(?![\\w-])"
    },
    "protocol": {
      "name": "storage.type.protocol.frr",
      "match": "(?<![\\w-])(bgp|ospf6|ospf|isis|ripng|rip|babel|pim|ldp|eigrp|nhrp)(?![\\w-])"
    },
    "verb": {
      "name": "keyword.operator.word.frr",
      "match": "(?<![\\w-])(permit|deny|match|set|redistribute|import|export|call|continue|exit|goto|on-match|next)(?![\\w-])"
    },
    "family": {
      "name": "support.type.address-family.frr",
      "match": "(?<![\\w-])(ipv4|ipv6|unicast|multicast|vpn|evpn|flowspec|labeled-unicast|l2vpn)(?![\\w-])"
    }
  }
}
