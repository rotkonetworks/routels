{
  "name": "Debian interfaces",
  "scopeName": "source.debinterfaces",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#ip6" },
    { "include": "#prefix" },
    { "include": "#ip4" },
    { "include": "#number" },
    { "include": "#stanza" },
    { "include": "#family" },
    { "include": "#method" },
    { "include": "#option" }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.number-sign.debinterfaces",
      "match": "^\\s*#.*$"
    },
    "strings": {
      "name": "string.quoted.double.debinterfaces",
      "begin": "\"",
      "end": "\""
    },
    "ip6": {
      "name": "constant.numeric.ip.debinterfaces",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "prefix": {
      "name": "constant.numeric.ip.debinterfaces",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip4": {
      "name": "constant.numeric.ip.debinterfaces",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "number": {
      "name": "constant.numeric.debinterfaces",
      "match": "\\b\\d+\\b"
    },
    "stanza": {
      "name": "keyword.control.debinterfaces",
      "match": "\\b(allow-auto|allow-hotplug|no-auto-down|no-scripts|auto|iface|mapping|source-directory|source|rename)\\b"
    },
    "family": {
      "name": "storage.type.family.debinterfaces",
      "match": "\\b(inet6|inet|ipx|can)\\b"
    },
    "method": {
      "name": "storage.type.method.debinterfaces",
      "match": "\\b(static|dhcp|manual|loopback|bootp|ppp|tunnel|wvdial|ipv4ll|v4tunnel|6to4|wireguard)\\b"
    },
    "option": {
      "name": "keyword.other.debinterfaces",
      "match": "\\b(address|gateway|netmask|network|broadcast|pointopoint|hwaddress|dns-nameservers|dns-search|dns-domain|pre-up|post-up|pre-down|post-down|up|down|vlan-raw-device|bond-master|bond-mode|bond-slaves|bridge-ports|bridge-stp|bridge-fd|bridge-maxwait|mtu|metric|scope|table)\\b"
    }
  }
}
