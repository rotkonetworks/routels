{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "MikroTik RouterOS",
  "scopeName": "source.routeros",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#find" },
    { "include": "#path" },
    { "include": "#mac" },
    { "include": "#ip6" },
    { "include": "#prefix" },
    { "include": "#ip4" },
    { "include": "#number" },
    { "include": "#key" },
    { "include": "#verb" },
    { "include": "#bool" },
    { "include": "#keyword" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.routeros",
      "match": "^\\s*#.*$"
    },
    "string": {
      "name": "string.quoted.double.routeros",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.routeros",
          "match": "\\\\\""
        }
      ]
    },
    "find": {
      "name": "string.interpolated.find.routeros",
      "begin": "\\[",
      "end": "\\]"
    },
    "path": {
      "name": "keyword.control.path.routeros",
      "match": "^\\s*/[A-Za-z][A-Za-z0-9 \\-/]*"
    },
    "mac": {
      "name": "constant.numeric.mac.routeros",
      "match": "\\b([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\\b"
    },
    "ip6": {
      "name": "constant.numeric.ip.ipv6.routeros",
      "match": "\\b([0-9a-fA-F]{1,4}:)+[0-9a-fA-F:]+(/\\d{1,3})?"
    },
    "prefix": {
      "name": "constant.numeric.ip.cidr.routeros",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}/\\d{1,2}\\b"
    },
    "ip4": {
      "name": "constant.numeric.ip.ipv4.routeros",
      "match": "\\b\\d{1,3}(\\.\\d{1,3}){3}\\b"
    },
    "number": {
      "name": "constant.numeric.routeros",
      "match": "\\b\\d+(\\.\\d+)?(s|m|h|d|w)?\\b"
    },
    "key": {
      "name": "variable.parameter.routeros",
      "match": "\\b[a-z][a-z0-9-]*\\b(?==)"
    },
    "verb": {
      "name": "keyword.other.verb.routeros",
      "match": "\\b(add|set|remove|print|export|import|find|comment|enable|disable|move)\\b"
    },
    "bool": {
      "name": "constant.language.boolean.routeros",
      "match": "\\b(yes|no|true|false|default|disabled|enabled)\\b"
    },
    "keyword": {
      "name": "keyword.other.routeros",
      "match": "\\b(interface|bridge|ip|ipv6|routing|firewall|queue|address|gateway|distance|dst-address|src-address|from-pool|comment|name|interface-list|interface-list-member|chain|action)\\b"
    }
  }
}
